rules_version = '2';

// Only used if you turn on image uploads (ENABLE_IMAGE_UPLOADS in js/config.js),
// which needs Firebase Storage and the Blaze plan.
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('role', 'customer') == 'admin';
    }

    match /products/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }
  }
}
